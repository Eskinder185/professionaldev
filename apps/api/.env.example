# Local development only. These are public sample values; never reuse them outside local development.
DB_NAME=roadmap
DB_USER=roadmap_dev
DB_PASSWORD=roadmap_dev_password
DB_PORT=5432

# Required by the local-only HTTP Basic development profile.
# Use different values locally and never commit a populated .env file.
LOCAL_LEARNER_PASSWORD=replace-with-a-local-password
LOCAL_REVIEWER_PASSWORD=replace-with-a-different-local-password

# Production/default profile: obtain these public values from the chosen OIDC provider.
OIDC_ISSUER_URI=https://identity.example.com/realms/roadmap
OIDC_JWK_SET_URI=https://identity.example.com/realms/roadmap/protocol/openid-connect/certs
OIDC_AUDIENCE=roadmap-api
