# Copy to .env (gitignored) and edit. Nothing here is a real secret.

# Required. The SQLAlchemy URL for the careeros database. Keep the password out of version control.
CAREEROS_DATABASE_URL=postgresql+psycopg://careeros:change-me@127.0.0.1:5432/careeros

# Required. Private endpoints need "Authorization: Bearer <token>". Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CAREEROS_API_TOKEN=change-me-to-a-long-random-string

# Browser origins allowed to call the API (JSON list). Add your site's dev origin if it differs.
CAREEROS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:4173"]

# Interactive docs at /docs. Leave false unless you are developing.
CAREEROS_ENABLE_DOCS=false

# ---- ATS status sync (jobs/sync_ats_status.py) ----
# Directory for Playwright session files. Must be private to the service user (mode 700).
CAREEROS_SESSION_DIR=/var/lib/careeros/sessions

# Portal credentials are NOT stored in the database. ats_accounts.username_ref names the variables
# below, which hold the username and password for that account. Example for a row whose
# username_ref is "workday-acme":
#   CAREEROS_SECRET_WORKDAY_ACME_USERNAME=you@example.com
#   CAREEROS_SECRET_WORKDAY_ACME_PASSWORD=...
# Put them in a root-only file (mode 600) loaded by the systemd unit, not in this repository.

# ---- Interview simulator (local model) ----
# Any OpenAI-compatible server: LiteLLM (http://127.0.0.1:4000/v1), Ollama (http://127.0.0.1:11434/v1), LM Studio.
CAREEROS_LLM_BASE_URL=http://127.0.0.1:11434/v1
CAREEROS_LLM_MODEL=
# CAREEROS_LLM_API_KEY=
# Job text and your skill levels are sent to this server. Hosts that are not loopback/private LAN addresses
# are refused unless you set this to true.
CAREEROS_LLM_ALLOW_REMOTE=false

# ---- Public portfolio endpoint (read-only, published rows only) ----
# Off by default. Prefer exporting static JSON at build time (scripts/export_portfolio.py).
CAREEROS_PUBLIC_PORTFOLIO=false
CAREEROS_PUBLIC_RATE_LIMIT_PER_MINUTE=60
